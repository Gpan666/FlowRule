# ── 构建产物 ──
/target/
**/target/

# ── 旧版 egui 备份（非源码，仅本地回滚用）──
/legacy/

# ── 编译输出 / 发布二进制（可由源码复现；WinDivert 运行时见下方 assets 规则）──
/dist/

# ── Tauri 生成的临时 schema 缓存（入库无意义，构建时自动重生成）──
crates/rl-app/gen/

# ── 二进制运行时文件：不入库，CI 构建时自动从 Release 下载，
#    本地开发手动放置（windivert-sys 运行时动态加载，编译本身不需要它们）──
/assets/*.dll
/assets/*.sys
/assets/*.lib

# ── 验证截图（仅根目录临时产物；正式截图见 docs/screenshots/，不被忽略）──
/ui-*.png

# ── 工具 / AI 本地状态 ──
.workbuddy/
.workbuddy-ai/

# ── 编辑器 / 系统 ──
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store

# ── 临时备份 ──
*.rs.bak
*.toml.bak

# ── Release 打包产物（已上传 GitHub Release，不需进仓库）──
liulv-*.zip
FlowRule-*.zip

# AI 工具本地状态与生成包
/.trae/
/.trae-html-share-packages/

# 本地安装目录备份（含 exe 二进制，不入库）
backup/
