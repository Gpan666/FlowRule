{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowRule",
  "version": "0.2.0",
  "identifier": "com.workbuddy.ratelimiter",
  "build": {
    "frontendDist": "./frontend"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "FlowRule",
        "width": 1180,
        "height": 920,
        "minWidth": 980,
        "minHeight": 660,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [],
    "publisher": "MOSS",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
